<Slide style={{ width: 1280, height: 720, background: '#07060B', padding: '20px 72px', display: 'flex', flexDirection: 'column' }}>
    <Box style={{ height: 100, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-start' }}>
        <Box style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
            <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#F2C96D', letterSpacing: 2.4 }}>THE ENGINE</Text>
            <Text style={{ fontSize: 38, fontFamily: 'Impact', color: '#F7F1E8', lineHeight: 1.1 }}>Same seed. Same market. Every time.</Text>
        </Box>
        <Text style={{ fontSize: 13, color: 'rgba(247,241,232,0.5)', letterSpacing: 1.6, paddingTop: 6 }}>PURE TYPESCRIPT · ZERO DEPENDENCIES</Text>
    </Box>

    <Box style={{ height: 480, marginTop: 20, flexDirection: 'row', gap: 44 }}>
        <Box style={{ width: 400, display: 'flex', flexDirection: 'column', justifyContent: 'space-between', height: 480 }}>
            <Box style={{ display: 'flex', flexDirection: 'column', gap: 2 }}>
                <Text style={{ fontSize: 60, fontWeight: 'bold', color: '#E73555', lineHeight: 0.95 }}>−12.8%</Text>
                <Text style={{ fontSize: 15, color: 'rgba(247,241,232,0.6)', letterSpacing: 1.4, marginTop: 8 }}>NEON HOLDINGS · 120 TICKS · SEED "DECK"</Text>
            </Box>
            <Box style={{ display: 'flex', flexDirection: 'column', gap: 12 }}>
                <Box style={{ flexDirection: 'row', gap: 14 }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#F2C96D', width: 22 }}>01</Text>
                    <Text style={{ fontSize: 15, color: 'rgba(247,241,232,0.78)', lineHeight: 1.5, flex: 1 }}>Prices come from a seeded hash, not Math.random. Replay the seed and you get the identical path.</Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 14 }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#F2C96D', width: 22 }}>02</Text>
                    <Text style={{ fontSize: 15, color: 'rgba(247,241,232,0.78)', lineHeight: 1.5, flex: 1 }}>A House market maker quotes three levels per side, so there is always someone to trade against.</Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 14 }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#F2C96D', width: 22 }}>03</Text>
                    <Text style={{ fontSize: 15, color: 'rgba(247,241,232,0.78)', lineHeight: 1.5, flex: 1 }}>Price-time priority, partial fills, and a hard block on self-trading. Your own order cannot fill your own order.</Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 14 }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#F2C96D', width: 22 }}>04</Text>
                    <Text style={{ fontSize: 15, color: 'rgba(247,241,232,0.78)', lineHeight: 1.5, flex: 1 }}>Integer paise, reserved cash, average-cost basis. 60 fills in this run, every one reconciled to zero.</Text>
                </Box>
            </Box>
        </Box>

        <Box style={{ flex: 1, display: 'flex', flexDirection: 'column', gap: 12 }}>
            <Chart
                style={{ height: 392, width: '100%' }}
                chartType='lineChart'
                title='NEON · mid price, 120 ticks, one meltdown'
                titleColor='#F7F1E8'
                legendColor='rgba(247,241,232,0.6)'
                axisColor='rgba(247,241,232,0.45)'
                colors={['#E73555']}
                background='linear-gradient(180deg, #0C0A12 0%, #07060B 100%)'
                data={[
                    ['Tick', 'NEON'],
                    ['0', 420],
                    ['10', 422],
                    ['20', 421],
                    ['30', 422],
                    ['40', 413],
                    ['50', 415],
                    ['60', 417],
                    ['70', 402],
                    ['80', 355],
                    ['90', 370],
                    ['100', 366],
                    ['110', 366],
                    ['120', 366],
                ]}
            />
            <Box style={{ flexDirection: 'row', justifyContent: 'space-between' }}>
                <Text style={{ fontSize: 14, color: 'rgba(247,241,232,0.55)' }}>Open ₹420.00 · High ₹425.95 · Low ₹353.90</Text>
                <Text style={{ fontSize: 14, color: '#F2C96D' }}>Crash fires at tick 73 · severity 94/100</Text>
            </Box>
        </Box>
    </Box>

    <Box style={{ height: 60, marginTop: 20, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end', borderTop: '1px solid rgba(247,241,232,0.10)', paddingTop: 12 }}>
        <Text style={{ fontSize: 13, color: 'rgba(247,241,232,0.45)' }}>BROKE VEGAS · fictional markets, virtual money</Text>
        <Text style={{ fontSize: 13, color: 'rgba(247,241,232,0.45)' }}>03 / 12</Text>
    </Box>
</Slide>
