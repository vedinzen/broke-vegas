        </Box>

        <Box style={{ flex: 1, display: 'flex', flexDirection: 'column', gap: 12 }}>
            <Image src="assets/09-replay.png" style={{ width: 424, height: 400, objectFit: 'cover', objectPosition: 'top', border: '1px solid rgba(247,241,232,0.14)', borderRadius: 10 }} />
