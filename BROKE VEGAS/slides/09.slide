        <Box style={{ width: 600, display: 'flex', flexDirection: 'column', justifyContent: 'space-between' }}>
            <Box style={{ display: 'flex', flexDirection: 'column', gap: 16 }}>
                <Text style={{ fontSize: 19, color: 'rgba(247,241,232,0.76)', lineHeight: 1.6 }}>Every match records its seed, its intents and its ticks. The replay rebuilds the final state from that log alone and compares SHA-256 hashes. If they differ, the badge says so.</Text>
                <Box style={{ display: 'flex', flexDirection: 'column', gap: 10, padding: '16px 18px', background: 'rgba(247,241,232,0.045)', border: '1px solid rgba(247,241,232,0.10)' }}>
                    <Text style={{ fontSize: 12, color: 'rgba(247,241,232,0.5)', letterSpacing: 2 }}>SEED COMMITMENT · SHA-256</Text>
                    <Text style={{ fontSize: 14, color: '#F2C96D', letterSpacing: 0.6 }}>4524bc66845f0df34c56b14cdc9df636</Text>
                    <Text style={{ fontSize: 12, color: 'rgba(247,241,232,0.5)', letterSpacing: 2, marginTop: 4 }}>REVEALED AFTER CLOSE</Text>
                    <Text style={{ fontSize: 14, color: '#F7F1E8', letterSpacing: 0.6 }}>demo-ONXBW-42</Text>
                </Box>
            </Box>

            <Box style={{ display: 'flex', flexDirection: 'row', gap: 30 }}>
                <Box style={{ display: 'flex', flexDirection: 'column', gap: 2 }}>
                    <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#F7F1E8', lineHeight: 1 }}>12</Text>
                    <Text style={{ fontSize: 13, color: 'rgba(247,241,232,0.55)', letterSpacing: 1.2 }}>ENGINE TESTS PASSING</Text>
                </Box>
                <Box style={{ display: 'flex', flexDirection: 'column', gap: 2 }}>
                    <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#F7F1E8', lineHeight: 1 }}>0</Text>
                    <Text style={{ fontSize: 13, color: 'rgba(247,241,232,0.55)', letterSpacing: 1.2 }}>INVARIANT VIOLATIONS</Text>
