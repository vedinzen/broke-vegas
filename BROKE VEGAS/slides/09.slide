                    <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#F7F1E8', lineHeight: 1 }}>34</Text>
                    <Text style={{ fontSize: 13, color: 'rgba(247,241,232,0.55)', letterSpacing: 1.2 }}>LOG ENTRIES REPLAYED</Text>
                </Box>
