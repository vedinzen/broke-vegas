<Slide style={{ width: 1280, height: 720, background: '#07060B', padding: '20px 72px', display: 'flex', flexDirection: 'column' }}>
    <Box style={{ height: 100, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-start' }}>
        <Box style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
            <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#F2C96D', letterSpacing: 2.4 }}>ACCOUNTING</Text>
            <Text style={{ fontSize: 38, fontFamily: 'Impact', color: '#F7F1E8', lineHeight: 1.1 }}>Money is integers. Reservations are explicit.</Text>
        </Box>
        <Text style={{ fontSize: 13, color: 'rgba(247,241,232,0.5)', letterSpacing: 1.6, paddingTop: 6 }}>PAISE · LONG ONLY · NO FLOATS</Text>
    </Box>

    <Box style={{ height: 480, marginTop: 20, flexDirection: 'row', gap: 36 }}>
        <Box style={{ width: 640, height: 480, padding: '14px 18px', background: 'rgba(247,241,232,0.04)', border: '1px solid rgba(247,241,232,0.10)', borderRadius: 8, display: 'flex', flexDirection: 'column' }}>
            <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', paddingBottom: 10, borderBottom: '1px solid rgba(247,241,232,0.08)' }}>
                <Text style={{ fontSize: 11, fontFamily: 'Consolas', color: '#F2C96D', letterSpacing: 0.8 }}>packages/engine/engine.ts</Text>
                <Text style={{ fontSize: 11, fontFamily: 'Consolas', color: 'rgba(247,241,232,0.4)' }}>submitOrder / verifyInvariants</Text>
            </Box>
            <Box style={{ display: 'flex', flexDirection: 'column', gap: 0, marginTop: 12 }}>
                {[
                { t: "// buy limit: cash leaves the spendable balance at submit", c: "rgba(247,241,232,0.36)" },
                { t: "const reserve = order.qty * (order.limitPrice ?? 0);", c: "#F7F1E8" },
                { t: "player.cash -= reserve;", c: "#F7F1E8" },
                { t: "player.reserved += reserve;", c: "#E73555" },
                { t: " ", c: "#F7F1E8" },
                { t: "// cancel: only the unfilled remainder comes back", c: "rgba(247,241,232,0.36)" },
                { t: "const release = remaining(order) * (order.limitPrice ?? 0);", c: "#F7F1E8" },
                { t: "player.reserved -= release;", c: "#F7F1E8" },
                { t: "player.cash += release;", c: "#F7F1E8" },
                { t: " ", c: "#F7F1E8" },
                { t: "// every write is checked, not assumed", c: "rgba(247,241,232,0.36)" },
                { t: "if (!Number.isSafeInteger(player.cash) || player.cash < 0)", c: "#F7F1E8" },
                { t: "  errors.push(player.id + \": invalid cash \" + player.cash);", c: "#F7F1E8" },
                { t: "if (position.reservedQty > position.qty)", c: "#F7F1E8" },
                { t: "  errors.push(player.id + \"/\" + symbol + \": bad position\");", c: "#F7F1E8" }
                ].map((line, i) => (
                    <Text key={i} style={{ fontSize: 13.5, fontFamily: 'Consolas', color: line.c, lineHeight: 1.62, whiteSpace: 'pre' }}>{line.t}</Text>
                ))}
            </Box>
        </Box>

        <Box style={{ width: 460, display: 'flex', flexDirection: 'column', justifyContent: 'space-between' }}>
            <Box style={{ display: 'flex', flexDirection: 'column', gap: 16 }}>
                <Box style={{ flexDirection: 'row', gap: 12 }}>
                    <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#F2C96D', width: 20 }}>01</Text>
                    <Text style={{ fontSize: 14, color: 'rgba(247,241,232,0.78)', lineHeight: 1.5, flex: 1 }}>Money is an integer number of paise. The 1,00,000 rupee stack is 10,000,000, and every write passes Number.isSafeInteger, so there is no float drift and no rounding rule to argue about.</Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 12 }}>
                    <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#F2C96D', width: 20 }}>02</Text>
                    <Text style={{ fontSize: 14, color: 'rgba(247,241,232,0.78)', lineHeight: 1.5, flex: 1 }}>cash and reserved are separate counters, so a resting order cannot spend the same rupee twice. Equity is cash + reserved + sum of qty times mid, which means placing an order never moves your equity.</Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 12 }}>
                    <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#F2C96D', width: 20 }}>03</Text>
                    <Text style={{ fontSize: 14, color: 'rgba(247,241,232,0.78)', lineHeight: 1.5, flex: 1 }}>reservedQty is never allowed above qty. Positions are long-only whole shares, so a holding cannot go negative even if two orders race.</Text>
                </Box>
            </Box>
            <Box style={{ padding: '12px 14px', background: 'rgba(231,53,85,0.10)', borderLeft: '3px solid #E73555' }}>
                <Text style={{ fontSize: 13.5, color: '#F7F1E8', lineHeight: 1.5 }}>The CLI simulation reconciles 60 fills to zero invariant errors, and the same check runs over randomised order flows in the test suite.</Text>
            </Box>
        </Box>
    </Box>

    <Box style={{ height: 60, marginTop: 20, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end', borderTop: '1px solid rgba(247,241,232,0.10)', paddingTop: 12 }}>
        <Text style={{ fontSize: 13, color: 'rgba(247,241,232,0.45)' }}>BROKE VEGAS · fictional markets, virtual money</Text>
        <Text style={{ fontSize: 13, color: 'rgba(247,241,232,0.45)' }}>06 / 12</Text>
    </Box>
</Slide>
