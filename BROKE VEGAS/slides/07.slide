<Slide style={{ width: 1280, height: 720, background: '#07060B', padding: '20px 72px', display: 'flex', flexDirection: 'column' }}>
    <Box style={{ height: 100, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-start' }}>
        <Box style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
            <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#F2C96D', letterSpacing: 2.4 }}>THE TERMINAL</Text>
            <Text style={{ fontSize: 38, fontFamily: 'Impact', color: '#F7F1E8', lineHeight: 1.1 }}>Dense on purpose.</Text>
        </Box>
        <Text style={{ fontSize: 13, color: 'rgba(247,241,232,0.5)', letterSpacing: 1.6, paddingTop: 6 }}>SCREENSHOT · LIVE DEPLOYMENT</Text>
    </Box>

    <Box style={{ height: 480, marginTop: 20, flexDirection: 'row', gap: 32 }}>
        <Box style={{ width: 748, display: 'flex', flexDirection: 'column', gap: 12 }}>
            <Image src="assets/04-terminal.png" style={{ width: 748, height: 442, objectFit: 'cover', border: '1px solid rgba(247,241,232,0.14)', borderRadius: 10, boxShadow: '0 24px 60px rgba(0,0,0,0.55)' }} />
            <Box style={{ flexDirection: 'row', justifyContent: 'space-between' }}>
                <Text style={{ fontSize: 13, color: 'rgba(247,241,232,0.55)' }}>The Obsidian Table · room ONXBW · tick 9 of 600</Text>
                <Text style={{ fontSize: 13, color: 'rgba(247,241,232,0.55)' }}>1440 × 900, production build</Text>
            </Box>
        </Box>

        <Box style={{ flex: 1, display: 'flex', flexDirection: 'column', justifyContent: 'space-between' }}>
            <Box style={{ display: 'flex', flexDirection: 'column', gap: 14 }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#F7F1E8', lineHeight: 1.4 }}>Everything a trader needs, and nothing that flatters them.</Text>
                <Text style={{ fontSize: 16, color: 'rgba(247,241,232,0.7)', lineHeight: 1.55 }}>Candles and volume, a live order book split into House and player liquidity, market and limit orders, open orders you can cancel, and a fill tape that never rounds in your favour.</Text>
            </Box>
            <Box style={{ display: 'flex', flexDirection: 'column', gap: 16 }}>
                <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'baseline', paddingBottom: 10, borderBottom: '1px solid rgba(247,241,232,0.12)' }}>
                    <Text style={{ fontSize: 14, color: 'rgba(247,241,232,0.6)', letterSpacing: 1.2 }}>SPREAD ON NEON</Text>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#F7F1E8' }}>₹0.30</Text>
                </Box>
                <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'baseline', paddingBottom: 10, borderBottom: '1px solid rgba(247,241,232,0.12)' }}>
                    <Text style={{ fontSize: 14, color: 'rgba(247,241,232,0.6)', letterSpacing: 1.2 }}>CASH RESERVED ON A LIMIT</Text>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#F7F1E8' }}>Exact, to the paise</Text>
                </Box>
                <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'baseline', paddingBottom: 10, borderBottom: '1px solid rgba(247,241,232,0.12)' }}>
                    <Text style={{ fontSize: 14, color: 'rgba(247,241,232,0.6)', letterSpacing: 1.2 }}>ORDER BOOK LEVELS SHOWN</Text>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#F7F1E8' }}>7 per side</Text>
                </Box>
                <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'baseline' }}>
                    <Text style={{ fontSize: 14, color: 'rgba(247,241,232,0.6)', letterSpacing: 1.2 }}>MOBILE</Text>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#F2C96D' }}>Tabbed, no overflow</Text>
                </Box>
            </Box>
        </Box>
    </Box>

    <Box style={{ height: 60, marginTop: 20, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end', borderTop: '1px solid rgba(247,241,232,0.10)', paddingTop: 12 }}>
        <Text style={{ fontSize: 13, color: 'rgba(247,241,232,0.45)' }}>BROKE VEGAS · fictional markets, virtual money</Text>
        <Text style={{ fontSize: 13, color: 'rgba(247,241,232,0.45)' }}>07 / 12</Text>
    </Box>
</Slide>
